# .env.template
# Copy this file to .env and fill in your site-specific values
# Command: cp .env.template .env

# ── App ───────────────────────────────────────────────────────────────────────
APP_VERSION=1.0.0

# ── Django ────────────────────────────────────────────────────────────────────
# Generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=generate-a-unique-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.prod

# ── Superuser — created automatically on first start ─────────────────────────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@yourhospital.ac.ke
DJANGO_SUPERUSER_PASSWORD=change-this-to-a-strong-password

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=redcap_sync
DB_USER=redcap_user
DB_PASSWORD=change-this-to-a-strong-password
DB_HOST=db
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── R service ─────────────────────────────────────────────────────────────────
R_SYNC_SERVICE_URL=http://r-service:8000
R_SYNC_SERVICE_TIMEOUT=300

# ── Token encryption ──────────────────────────────────────────────────────────
# Generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CRITICAL: Back this up safely — losing it means all stored tokens are unrecoverable
REDCAP_TOKEN_ENCRYPTION_KEY=generate-a-unique-key-here

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# ── Ports ─────────────────────────────────────────────────────────────────────
POSTGRES_PORT=5432
REDIS_PORT=6379
DJANGO_PORT=8001
R_SERVICE_PORT=8000
FRONTEND_PORT=80